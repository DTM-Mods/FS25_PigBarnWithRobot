        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="tubeLight03" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="tubeLight04" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="tubeLight05" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="tubeLight06" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <infoTrigger triggerNode="infoTriggerVector" />

    <!-- Sized for 1500 adult pigs: per month ~180000 l food, ~90000 l straw, ~150000 l liquid manure, ~112500 l manure -->
    <husbandry saveId="Animals_PIG" hasStatistics="false">
        <storage node="storage" fillTypes="LIQUIDMANURE STRAW MANURE" isExtension="false">
            <capacity fillType="LIQUIDMANURE" capacity="1500000" />
            <capacity fillType="STRAW"        capacity="1000000" />
            <capacity fillType="MANURE"       capacity="1200000" />
        </storage>

        <unloadingStation supportsExtension="true" storageRadius="65" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="exactFillRootNodeStraw" fillTypes="STRAW" />
            <unloadTrigger fillTypes="MANURE LIQUIDMANURE" />
            <!-- straw bales dropped in the feed alley go into the straw storage (the cow barn's silage bale trigger).
                 fillTypes is required here: without it the unloading station errors while loading and the savegame hangs at 0 % -->
            <baleTrigger triggerNode="baleTrigger" fillTypes="STRAW" />
        </unloadingStation>

        <loadingStation supportsExtension="true" storageRadius="50" fillTypes="STRAW">
            <!-- manure loads at the slurry point too, a manure heap in range still works as extra storage -->
            <loadTrigger triggerNode="lqiuidManureTrigger" fillTypes="LIQUIDMANURE MANURE" fillLitersPerSecond="2000" aiNode="aiLoadingNodeLiquidManure" />
        </loadingStation>

        <animals type="PIG" baseMaxNumAnimals="1500" maxNumAnimals="1500" >
            <navigation shape="navigationMeshShape"/>
            <loadingTrigger node="loadingTrigger" />
        </animals>

        <straw>
            <manure factor="1.5" />
            <strawPlane node="strawPlane" minY="-0.15" maxY="0.0" colorChange="false" />
        </straw>

        <water automaticWaterSupply="true">
            <waterPlaces>
                <waterPlace node="waterPlace1" />
                <waterPlace node="waterPlace2" />
                <waterPlace node="waterPlace3" />
                <waterPlace node="waterPlace4" />
            </waterPlaces>
        </water>

        <liquidManure />

        <food capacity="800000">
            <foodPlaces>
                <foodPlace node="foodPlace1" />
                <foodPlace node="foodPlace2" />
                <foodPlace node="foodPlace3" />
                <foodPlace node="foodPlace4" />
                <foodPlace node="foodPlace5" />
                <foodPlace node="foodPlace6" />
                <foodPlace node="foodPlace7" />
                <foodPlace node="foodPlace8" />
            </foodPlaces>
            <dynamicFoodPlane node="fillVolumeFood" defaultFillType="pigFood" maxAllowedHeapAngle="60" maxSubDivEdgeLength="0.5" capacity="10000"/>
            <!-- feed can still be tipped straight into the alley, e.g. crops the robot bunkers don't take -->
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood" />
        </food>

        <feedingRobot linkNode="dairyFeedF4500" class="FeedingRobot" filename="placeables/pigFeedRobot.xml">
            <splines>
                <spline node="geaSplineReverse"  direction="-1"/>
                <spline fakeLength="1"/>
                <spline node="geaSplineToSilage" direction="1" stopAtEnd="true" />
                <spline node="geaSplineToStraw" direction="1"  stopAtEnd="true"/>
                <spline node="geaSplineToHay" direction="1"  stopAtEnd="true"/>
                <spline node="geaSplineToMineralFeed" direction="1" stopAtEnd="true"/>
                <spline node="geaSplineToBarn"   direction="1"/>
                <spline node="geaSplineFeeding"  direction="1" isFeeding="true"/>
                <spline node="geaSplineToGarage" direction="1"/>
            </splines>
            <animatedObjects>
                <animatedObject index="2" direction="1" />
            </animatedObjects>
        </feedingRobot>

        <fence xmlFilename="$data/placeables/brandless/fences/husbandries/cowFence/cowFence.xml">
            <sections>
                <section segmentId="SEGMENT" customizable="true">
                    <node node="fence1Node1" />
                    <node node="fence1Node2" />
                    <node node="fence1Node3" />
                    <node node="fence1Node4" />
                </section>
            </sections>
        </fence>

        <meadow>
            <createTask weedState="0">
                <fruit type="UNKNOWN" growthState="0"/>
                <ground type="NONE" />
                <terrainGroundType name="dirt" />
            </createTask>
        </meadow>
    </husbandry>

