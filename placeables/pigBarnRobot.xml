<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- GEA cow barn (rudolfHormann/cowBarnBig) converted to a 1500 pig barn. The feeding robot mixes PIGFOOD (see scripts/PigFeedRecipe.lua). -->
<placeable type="pigHusbandryFeedingRobot" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_pigBarnRobot</name>
        <image>placeables/store_pigBarnRobot.png</image>
        <price>800000</price>
        <functions>
            <function>$l10n_function_pigBarnRobot</function>
            <function>$l10n_function_animalPenPig</function>
            <function>$l10n_function_adjustableMeadow</function>
        </functions>
        <lifetime>1000</lifetime>
        <dailyUpkeep>700</dailyUpkeep>
        <rotation>0</rotation>
        <brand>RUDOLFHOERMANN</brand>
        <species>PLACEABLE</species>
        <category>animalpens</category>
        <brush>
            <type>husbandry</type>
            <category>animals</category>
            <tab>pigs</tab>
        </brush>
        <vertexBufferMemoryUsage>4445440</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>1100288</indexBufferMemoryUsage>
        <textureMemoryUsage>3276800</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

        <storeIconRendering>
            <settings cameraXRot="-15" cameraYRot="70" zoomFactor="1.1" />
        </storeIconRendering>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>$data/placeables/rudolfHormann/cowBarnBig/cowBarnBig.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
            <testArea startNode="testAreaStart02_vector" endNode="testAreaEnd02_vector" />
        </testAreas>

        <sounds>
            <place template="largeImp" />
            <placeLayered template="pigLayer" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
        <clearArea startNode="clearAreaStart03" widthNode="clearAreaWidth03" heightNode="clearAreaHeight03"/>
        <clearArea startNode="clearAreaStart04" widthNode="clearAreaWidth04" heightNode="clearAreaHeight04"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="dirt"/>
            <levelArea startNode="levelAreaStart02" widthNode="levelAreaWidth02" heightNode="levelAreaHeight02" groundType="dirt"/>
            <levelArea startNode="levelAreaStart03" widthNode="levelAreaWidth03" heightNode="levelAreaHeight03" groundType="dirt"/>
            <levelArea startNode="levelAreaStart04" widthNode="levelAreaWidth04" heightNode="levelAreaHeight04" groundType="dirt"/>
        </levelAreas>

        <paintAreas>
            <paintArea startNode="paintAreaStart04" widthNode="paintAreaWidth04" heightNode="paintAreaHeight04" groundType="gravel"/>
            <paintArea startNode="paintAreaStart05" widthNode="paintAreaWidth05" heightNode="paintAreaHeight05" groundType="gravel"/>
            <paintArea startNode="paintAreaStart06" widthNode="paintAreaWidth06" heightNode="paintAreaHeight06" groundType="gravel"/>
            <!-- concrete under the whole feed robot yard, including the tip zones in front of the bins and silo -->
            <paintArea startNode="levelAreaStart02" widthNode="levelAreaWidth02" heightNode="levelAreaHeight02" groundType="concrete"/>
        </paintAreas>
    </leveling>

    <foliageAreas>
    </foliageAreas>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02"/>

